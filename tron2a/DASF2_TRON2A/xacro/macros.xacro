<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- tron2-xacro helpers begin -->
  <!-- Helper. One ros2_control joint with position/velocity/effort command and state -->
  <xacro:macro name="tron2_ctrl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <!-- Helper. One ROS1 effort controlled joint -->
  <xacro:macro name="tron2_transmission" params="name">
    <transmission name="${name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- 反射转子惯量，MuJoCo <joint armature> 的 URDF 等价物（URDF 与 SDF 都没有 armature）。
       在关节的子连杆上刚性附着一个薄圆盘，izz=armature、ixx=iyy=armature/2，满足刚体惯量
       三角不等式。rpy 把圆盘 z 轴转到关节轴上，取 0、acos(z)、atan2(y,x)。
       与原生 armature 的偏差在于转子也会加载上游关节，末端精确，越靠根部偏高越多。
       依赖 Gazebo 默认的 fixed-joint lumping，转子关节上不要设 disableFixedJointLumping。
       移动关节不加，其 armature 单位为 kg，复现它等于给连杆加真实质量与重力。
       规则与推导见 tron2-xacro skill 的 references/armature.md。 -->
  <xacro:macro name="rotor_inertia" params="joint child armature mass:=1e-4 rpy:='0 0 0'">
    <link name="${joint}_rotor">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${armature / 2.0}" iyy="${armature / 2.0}" izz="${armature}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${joint}_rotor_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <parent link="${child}"/>
      <child link="${joint}_rotor"/>
    </joint>
  </xacro:macro>
  <!-- tron2-xacro helpers end -->

  <!--
    DASF2_TRON2A (centaur, SF x2 + DACH). The body is lifted verbatim from
    urdf/robot.urdf, which is the maintained source of truth for this variant.

    Both ROS layers exist. The joint lists are generated by the tron2-xacro skill
    from the xml actuator order, which is the RobotCmd wire order shared with the
    MuJoCo simulator. tron2-gazebo-ros2 develop does not list DASF2_TRON2A in
    ROS2_SUPPORTED yet, so its launch refuses this type until Tron2HWSim gains a
    DASF2 branch in parseJointIndex. The three IMU sensor names below follow the
    link names and must be confirmed against that branch when it lands.
  -->

  <!-- Helper. Gazebo surface properties for one link -->
  <xacro:macro name="gazebo_link_surface" params="name material mu:=0.2">
    <gazebo reference="${name}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
      <self_collide>1</self_collide>
      <material>${material}</material>
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>
  </xacro:macro>

  <!-- Contact / visual surface properties. ROS version neutral, always emitted.
       mu=2.0 on the four ankle links is the foot sole contact patch. -->
  <xacro:macro name="gazebo_link_surfaces_all">
    <xacro:gazebo_link_surface name="front_base_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="proximal_pitch_L_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_L_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_L_F_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="knee_L_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="ankle_pitch_L_F_Link" material="Gazebo/DarkGrey" mu="2.0" />
    <xacro:gazebo_link_surface name="proximal_pitch_R_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_R_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_R_F_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="knee_R_F_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="ankle_pitch_R_F_Link" material="Gazebo/DarkGrey" mu="2.0" />
    <xacro:gazebo_link_surface name="transition_middle_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="back_base_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="proximal_pitch_L_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_L_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_L_B_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="knee_L_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="ankle_pitch_L_B_Link" material="Gazebo/DarkGrey" mu="2.0" />
    <xacro:gazebo_link_surface name="proximal_pitch_R_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_R_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_R_B_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="knee_R_B_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="ankle_pitch_R_B_Link" material="Gazebo/DarkGrey" mu="2.0" />
    <xacro:gazebo_link_surface name="transition_upper_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="upper_base_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="proximal_pitch_L_H_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_L_H_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_L_H_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="elbow_L_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_yaw_L_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_pitch_L_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_roll_L_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="grasper_L_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_pitch_R_H_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_roll_R_H_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="proximal_yaw_R_H_Link" material="Gazebo/White" />
    <xacro:gazebo_link_surface name="elbow_R_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_yaw_R_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_pitch_R_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="wrist_roll_R_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="grasper_R_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="head_yaw_Link" material="Gazebo/DarkGrey" />
    <xacro:gazebo_link_surface name="head_pitch_Link" material="Gazebo/DarkGrey" />
  </xacro:macro>

  <!-- ==================== ROS2 Gazebo Macro ==================== -->
  <xacro:macro name="ros2_gazebo_all">

    <!-- ros2_control plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find tron2_gazebo)/config/default_tron2.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- Never write a colon followed by a space anywhere in this file, comments
         included. gazebo_ros2_control parses the whole URDF as a YAML parameter
         override and that sequence silently drops the hardware plugin. -->
    <ros2_control name="dasf2_ros2_control" type="system">
      <hardware>
        <plugin>tron2_gazebo/Tron2HWSim</plugin>
      </hardware>

      <!-- tron2-xacro auto begin ros2-joints -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_L_F_Joint" />  <!-- idx 0 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_L_F_Joint" />  <!-- idx 1 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_L_F_Joint" />  <!-- idx 2 -->
      <xacro:tron2_ctrl_joint name="knee_L_F_Joint" />  <!-- idx 3 -->
      <xacro:tron2_ctrl_joint name="ankle_pitch_L_F_Joint" />  <!-- idx 4 -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_R_F_Joint" />  <!-- idx 5 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_R_F_Joint" />  <!-- idx 6 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_R_F_Joint" />  <!-- idx 7 -->
      <xacro:tron2_ctrl_joint name="knee_R_F_Joint" />  <!-- idx 8 -->
      <xacro:tron2_ctrl_joint name="ankle_pitch_R_F_Joint" />  <!-- idx 9 -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_L_B_Joint" />  <!-- idx 10 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_L_B_Joint" />  <!-- idx 11 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_L_B_Joint" />  <!-- idx 12 -->
      <xacro:tron2_ctrl_joint name="knee_L_B_Joint" />  <!-- idx 13 -->
      <xacro:tron2_ctrl_joint name="ankle_pitch_L_B_Joint" />  <!-- idx 14 -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_R_B_Joint" />  <!-- idx 15 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_R_B_Joint" />  <!-- idx 16 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_R_B_Joint" />  <!-- idx 17 -->
      <xacro:tron2_ctrl_joint name="knee_R_B_Joint" />  <!-- idx 18 -->
      <xacro:tron2_ctrl_joint name="ankle_pitch_R_B_Joint" />  <!-- idx 19 -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_L_H_Joint" />  <!-- idx 20 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_L_H_Joint" />  <!-- idx 21 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_L_H_Joint" />  <!-- idx 22 -->
      <xacro:tron2_ctrl_joint name="elbow_L_Joint" />  <!-- idx 23 -->
      <xacro:tron2_ctrl_joint name="wrist_yaw_L_Joint" />  <!-- idx 24 -->
      <xacro:tron2_ctrl_joint name="wrist_pitch_L_Joint" />  <!-- idx 25 -->
      <xacro:tron2_ctrl_joint name="wrist_roll_L_Joint" />  <!-- idx 26 -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_R_H_Joint" />  <!-- idx 27 -->
      <xacro:tron2_ctrl_joint name="proximal_roll_R_H_Joint" />  <!-- idx 28 -->
      <xacro:tron2_ctrl_joint name="proximal_yaw_R_H_Joint" />  <!-- idx 29 -->
      <xacro:tron2_ctrl_joint name="elbow_R_Joint" />  <!-- idx 30 -->
      <xacro:tron2_ctrl_joint name="wrist_yaw_R_Joint" />  <!-- idx 31 -->
      <xacro:tron2_ctrl_joint name="wrist_pitch_R_Joint" />  <!-- idx 32 -->
      <xacro:tron2_ctrl_joint name="wrist_roll_R_Joint" />  <!-- idx 33 -->
      <xacro:tron2_ctrl_joint name="head_pitch_Joint" />  <!-- idx 34 -->
      <xacro:tron2_ctrl_joint name="head_yaw_Joint" />  <!-- idx 35 -->
      <!-- tron2-xacro auto end ros2-joints -->

      <!-- IMU state interfaces, front / back / upper body -->
      <sensor name="limx_F_imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
      <sensor name="limx_B_imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
      <sensor name="limx_H_imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
    </ros2_control>

    <!-- IMU Gazebo sensor plugins (ROS2) -->
    <gazebo reference="limx_F_imu">
      <sensor type="imu" name="limx_F_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_F_plugin">
          <ros>
            <namespace>imu_F</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="limx_B_imu">
      <sensor type="imu" name="limx_B_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_B_plugin">
          <ros>
            <namespace>imu_B</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="limx_H_imu">
      <sensor type="imu" name="limx_H_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_H_plugin">
          <ros>
            <namespace>imu_H</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Ground truth pose plugin (ROS2 snake_case) -->
    <gazebo>
      <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
        <ros>
          <remapping>odom:=ground_truth/state</remapping>
        </ros>
        <update_rate>1000.0</update_rate>
        <body_name>base_Link</body_name>
        <frame_name>world</frame_name>
        <gaussian_noise>0.0</gaussian_noise>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
      </plugin>
    </gazebo>

  </xacro:macro>

  <!-- ==================== ROS1 Gazebo Macro ==================== -->
  <xacro:macro name="ros1_gazebo_all">

    <gazebo>
      <plugin filename="libtron2_hw_sim.so" name="gazebo_ros_control">
        <robotNamespace>/</robotNamespace>
        <robotParam>robot_description</robotParam>
        <robotSimType>tron2_gazebo/Tron2HWSim</robotSimType>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
        <alwaysOn>true</alwaysOn>
        <updateRate>1000.0</updateRate>
        <bodyName>base_Link</bodyName>
        <topicName>ground_truth/state</topicName>
        <gaussianNoise>0</gaussianNoise>
        <frameName>world</frameName>
        <xyzOffsets>0 0 0</xyzOffsets>
        <rpyOffsets>0 0 0</rpyOffsets>
      </plugin>
    </gazebo>

    <!-- tron2-xacro auto begin ros1-transmissions -->
    <xacro:tron2_transmission name="proximal_pitch_L_F_Joint" />  <!-- idx 0 -->
    <xacro:tron2_transmission name="proximal_roll_L_F_Joint" />  <!-- idx 1 -->
    <xacro:tron2_transmission name="proximal_yaw_L_F_Joint" />  <!-- idx 2 -->
    <xacro:tron2_transmission name="knee_L_F_Joint" />  <!-- idx 3 -->
    <xacro:tron2_transmission name="ankle_pitch_L_F_Joint" />  <!-- idx 4 -->
    <xacro:tron2_transmission name="proximal_pitch_R_F_Joint" />  <!-- idx 5 -->
    <xacro:tron2_transmission name="proximal_roll_R_F_Joint" />  <!-- idx 6 -->
    <xacro:tron2_transmission name="proximal_yaw_R_F_Joint" />  <!-- idx 7 -->
    <xacro:tron2_transmission name="knee_R_F_Joint" />  <!-- idx 8 -->
    <xacro:tron2_transmission name="ankle_pitch_R_F_Joint" />  <!-- idx 9 -->
    <xacro:tron2_transmission name="proximal_pitch_L_B_Joint" />  <!-- idx 10 -->
    <xacro:tron2_transmission name="proximal_roll_L_B_Joint" />  <!-- idx 11 -->
    <xacro:tron2_transmission name="proximal_yaw_L_B_Joint" />  <!-- idx 12 -->
    <xacro:tron2_transmission name="knee_L_B_Joint" />  <!-- idx 13 -->
    <xacro:tron2_transmission name="ankle_pitch_L_B_Joint" />  <!-- idx 14 -->
    <xacro:tron2_transmission name="proximal_pitch_R_B_Joint" />  <!-- idx 15 -->
    <xacro:tron2_transmission name="proximal_roll_R_B_Joint" />  <!-- idx 16 -->
    <xacro:tron2_transmission name="proximal_yaw_R_B_Joint" />  <!-- idx 17 -->
    <xacro:tron2_transmission name="knee_R_B_Joint" />  <!-- idx 18 -->
    <xacro:tron2_transmission name="ankle_pitch_R_B_Joint" />  <!-- idx 19 -->
    <xacro:tron2_transmission name="proximal_pitch_L_H_Joint" />  <!-- idx 20 -->
    <xacro:tron2_transmission name="proximal_roll_L_H_Joint" />  <!-- idx 21 -->
    <xacro:tron2_transmission name="proximal_yaw_L_H_Joint" />  <!-- idx 22 -->
    <xacro:tron2_transmission name="elbow_L_Joint" />  <!-- idx 23 -->
    <xacro:tron2_transmission name="wrist_yaw_L_Joint" />  <!-- idx 24 -->
    <xacro:tron2_transmission name="wrist_pitch_L_Joint" />  <!-- idx 25 -->
    <xacro:tron2_transmission name="wrist_roll_L_Joint" />  <!-- idx 26 -->
    <xacro:tron2_transmission name="proximal_pitch_R_H_Joint" />  <!-- idx 27 -->
    <xacro:tron2_transmission name="proximal_roll_R_H_Joint" />  <!-- idx 28 -->
    <xacro:tron2_transmission name="proximal_yaw_R_H_Joint" />  <!-- idx 29 -->
    <xacro:tron2_transmission name="elbow_R_Joint" />  <!-- idx 30 -->
    <xacro:tron2_transmission name="wrist_yaw_R_Joint" />  <!-- idx 31 -->
    <xacro:tron2_transmission name="wrist_pitch_R_Joint" />  <!-- idx 32 -->
    <xacro:tron2_transmission name="wrist_roll_R_Joint" />  <!-- idx 33 -->
    <xacro:tron2_transmission name="head_pitch_Joint" />  <!-- idx 34 -->
    <xacro:tron2_transmission name="head_yaw_Joint" />  <!-- idx 35 -->
    <!-- tron2-xacro auto end ros1-transmissions -->

  </xacro:macro>

  <!-- tron2-xacro auto begin rotor -->
  <xacro:macro name="rotor_inertia_all">
    <xacro:rotor_inertia joint="proximal_pitch_L_F_Joint" child="proximal_pitch_L_F_Link" armature="0.0685894" rpy="0 1.65806245894 1.57079632679"/>
    <xacro:rotor_inertia joint="proximal_roll_L_F_Joint" child="proximal_roll_L_F_Link" armature="0.0685894" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="proximal_yaw_L_F_Joint" child="proximal_yaw_L_F_Link" armature="0.0169834"/>
    <xacro:rotor_inertia joint="knee_L_F_Joint" child="knee_L_F_Link" armature="0.0685894" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="ankle_pitch_L_F_Joint" child="ankle_pitch_L_F_Link" armature="0.0169834" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="proximal_pitch_R_F_Joint" child="proximal_pitch_R_F_Link" armature="0.0685894" rpy="0 1.48353019465 1.57079632679"/>
    <xacro:rotor_inertia joint="proximal_roll_R_F_Joint" child="proximal_roll_R_F_Link" armature="0.0685894" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="proximal_yaw_R_F_Joint" child="proximal_yaw_R_F_Link" armature="0.0169834"/>
    <xacro:rotor_inertia joint="knee_R_F_Joint" child="knee_R_F_Link" armature="0.0685894" rpy="0 1.57079632679 1.57079632679"/>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Collision Geometry Macro ==================== -->
  <xacro:macro name="collision_mesh" params="mesh_filename">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_filename}" />
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="collision_box" params="prim_origin_xyz prim_origin_rpy prim_size">
    <collision>
      <origin xyz="${prim_origin_xyz}" rpy="${prim_origin_rpy}" />
      <geometry>
        <box size="${prim_size}" />
      </geometry>
    </collision>
  </xacro:macro>

  <!-- ==================== ROS1 Gazebo Macro ==================== -->
  <xacro:macro name="ros1_gazebo_all">

    <!-- ros_control plugin -->
    <gazebo>
      <plugin filename="libtron2_hw_sim.so" name="gazebo_ros_control">
        <robotNamespace>/</robotNamespace>
        <robotParam>robot_description</robotParam>
        <robotSimType>tron2_gazebo/Tron2HWSim</robotSimType>
      </plugin>
    </gazebo>

    <!-- Ground truth pose plugin (ROS1 camelCase) -->
    <gazebo>
      <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
        <alwaysOn>true</alwaysOn>
        <updateRate>1000.0</updateRate>
        <bodyName>base_Link</bodyName>
        <topicName>ground_truth/state</topicName>
        <gaussianNoise>0</gaussianNoise>
        <frameName>world</frameName>
        <xyzOffsets>0 0 0</xyzOffsets>
        <rpyOffsets>0 0 0</rpyOffsets>
      </plugin>
    </gazebo>

    <!-- D435 Camera ROS1 Plugin: split into two sensors instead of using
         libgazebo_ros_openni_kinect.so. The openni_kinect plugin deadlocks
         with gazebo_ros_control on Load() and prevents Tron2HWSim::initSim
         from being called. -->
    <gazebo reference="d435_Link">
      <sensor type="camera" name="d435_color_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5177</horizontal_fov>
          <image>
            <format>B8G8R8</format>
            <width>64</width>
            <height>48</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1.8</far>
          </clip>
        </camera>
        <plugin name="d435_color_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>d435</robotNamespace>
          <cameraName>color</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>d435_optical_frame</frameName>
        </plugin>
      </sensor>

      <sensor type="depth" name="d435_depth_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5177</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>64</width>
            <height>48</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1.8</far>
          </clip>
        </camera>
        <plugin name="d435_depth_controller" filename="libgazebo_ros_depth_camera.so">
          <robotNamespace>d435</robotNamespace>
          <!-- cameraName must differ from the color sensor; otherwise both
               plugins share the same set_camera_info / set_parameters
               services and Gazebo logs "Tried to advertise a service that
               is already advertised" on the second one. -->
          <cameraName>depth</cameraName>
          <!-- imageTopicName / cameraInfoTopicName publish the IR/grayscale
               frame from libgazebo_ros_depth_camera.so. Route them under
               infra/ so they don't collide with depthImageTopicName /
               depthImageCameraInfoTopicName (the real depth stream). -->
          <imageTopicName>infra/image_raw</imageTopicName>
          <cameraInfoTopicName>infra/camera_info</cameraInfoTopicName>
          <depthImageTopicName>image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>points</pointCloudTopicName>
          <frameName>d435_optical_frame</frameName>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>1.8</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Transmissions (ROS1) -->
    <transmission name="proximal_pitch_L_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_pitch_L_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_pitch_L_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="proximal_roll_L_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_roll_L_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_roll_L_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="proximal_yaw_L_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_yaw_L_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_yaw_L_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="knee_L_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="knee_L_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="knee_L_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="wheel_L_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wheel_L_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="wheel_L_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="proximal_pitch_R_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_pitch_R_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_pitch_R_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="proximal_roll_R_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_roll_R_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_roll_R_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="proximal_yaw_R_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="proximal_yaw_R_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="proximal_yaw_R_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="knee_R_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="knee_R_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="knee_R_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="wheel_R_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wheel_R_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="wheel_R_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>


    <transmission name="arm1_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm1_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm1_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm2_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm2_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm2_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm3_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm3_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm3_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm4_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm4_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm4_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm5_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm5_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm5_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm6_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm6_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm6_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="gripper1_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gripper1_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="gripper1_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="gripper2_Joint_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gripper2_Joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="gripper2_Joint_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

  </xacro:macro>

  <!-- ==================== ROS2 Gazebo Macro ==================== -->
  <xacro:macro name="ros2_gazebo_all">

    <!-- ros2_control plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find tron2_gazebo)/config/default_tron2.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- ros2_control block -->
    <ros2_control name="Tron2GazeboSystem" type="system">
      <hardware>
        <plugin>tron2_gazebo/Tron2HWSim</plugin>
      </hardware>

      <joint name="proximal_pitch_L_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="proximal_roll_L_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="proximal_yaw_L_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="knee_L_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="wheel_L_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="proximal_pitch_R_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="proximal_roll_R_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="proximal_yaw_R_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="knee_R_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="wheel_R_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm1_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm2_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm3_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm4_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm5_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="arm6_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="gripper1_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="gripper2_Joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <command_interface name="effort" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <sensor name="base_imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
    </ros2_control>

    <!-- IMU Gazebo sensor plugin (ROS2) -->
    <gazebo reference="base_imu">
      <sensor type="imu" name="base_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <ros>
            <namespace></namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Ground truth pose plugin (ROS2 snake_case) -->
    <gazebo>
      <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
        <ros>
          <remapping>odom:=ground_truth/state</remapping>
        </ros>
        <update_rate>1000.0</update_rate>
        <body_name>base_Link</body_name>
        <frame_name>world</frame_name>
        <gaussian_noise>0.0</gaussian_noise>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
      </plugin>
    </gazebo>


    <!-- D435 Camera ROS2 Plugin -->
    <gazebo reference="d435_Link">
      <sensor type="depth" name="d435_camera_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5177</horizontal_fov>
          <image>
            <format>B8G8R8</format>
            <width>64</width>
            <height>48</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1.8</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>d435</namespace>
          </ros>
          <camera_name>d435_camera</camera_name>
          <frame_name>d435_optical_frame</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>1.8</max_depth>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

  <!-- 反射转子惯量：MuJoCo <joint armature> 的 URDF 等价物（URDF/SDF 无此属性）。做法是在关节的
       子连杆上刚性附着一个薄圆盘，izz=armature、ixx=iyy=armature/2 —— 薄圆盘精确值，且必须满足
       刚体惯量三角不等式（izz=armature、ixx=iyy≈0 的单轴惯量会被物理引擎拒绝）。
       动机：显式 PD 的稳定条件是 kd*dt < 2*M_ii。arm6 只挂着夹爪，夹爪收拢时 M_arm6 掉到
       4.2e-4，dt=1ms/kd=1 下 r=2.4 越界自激（表现为夹爪在 60mm 以下疯狂开合）；加后 r=0.087。
       与原生 armature 的偏差：末端 arm6 精确，arm1~arm5 偏高 8.6%~36.4%（转子惯量会同时加载
       上游关节，armature 不会）；真实轨迹差 ≤2.1% 行程。
       依赖 Gazebo 默认的 fixed-joint lumping，勿设 disableFixedJointLumping。
       rpy 需把圆盘 z 轴旋到关节轴；piper-x 六轴 axis 皆 "0 0 1" 故为 0，其它轴用
       rpy="0 ${acos(z)} ${atan2(y,x)}"。 -->
  <xacro:macro name="rotor_inertia" params="joint child armature mass:=1e-4 rpy:='0 0 0'">
    <link name="${joint}_rotor">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${armature / 2.0}" iyy="${armature / 2.0}" izz="${armature}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <!-- 挂在子连杆上：URDF 约定子连杆坐标系原点即关节位置，故 xyz 恒为 0 -->
    <joint name="${joint}_rotor_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <parent link="${child}"/>
      <child link="${joint}_rotor"/>
    </joint>
  </xacro:macro>

  <!-- 对齐 MJCF 的 armature="0.0110718"。夹爪两个 prismatic 关节刻意不在此列：移动自由度的
       armature 单位是 kg，用 URDF 复现等于给 25g 的手指加 11g 真实质量并引入 0.109N 重力载荷
       （armature 不会）；这两个关节裕度已有 10x，走 <dynamics damping> 隐式阻尼更合适。 -->
  <xacro:macro name="arm_rotor_inertia_all" params="armature:=0.0110718">
    <xacro:rotor_inertia joint="arm1_Joint" child="arm1_Link" armature="${armature}"/>
    <xacro:rotor_inertia joint="arm2_Joint" child="arm2_Link" armature="${armature}"/>
    <xacro:rotor_inertia joint="arm3_Joint" child="arm3_Link" armature="${armature}"/>
    <xacro:rotor_inertia joint="arm4_Joint" child="arm4_Link" armature="${armature}"/>
    <xacro:rotor_inertia joint="arm5_Joint" child="arm5_Link" armature="${armature}"/>
    <xacro:rotor_inertia joint="arm6_Joint" child="arm6_Link" armature="${armature}"/>
  </xacro:macro>

</robot>

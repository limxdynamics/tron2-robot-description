<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Helper: one position/velocity/effort controlled joint -->
  <xacro:macro name="tron2_ctrl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <!-- ==================== ROS2 Gazebo Macro ==================== -->
  <xacro:macro name="ros2_gazebo_all">

    <!-- ros2_control plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find tron2_gazebo)/config/default_tron2.yaml</parameters>
      </plugin>
    </gazebo>

    <!--
      DASF_TRON2A joint / RobotCmd index layout, which must match the external
      limxsdk controller that publishes RobotCmd via Tron2Sim.
        legs  (lower body)   0-9    L = pitch,roll,yaw,knee,ankle_pitch, then R
        arms  (upper body)   10-23  L = pitch,roll,yaw,elbow,wrist_yaw/pitch/roll, then R
        head                 24 = head_yaw, 25 = head_pitch
      See Tron2HWSim::parseJointIndex for robot_type_ == "DASF_TRON2A".
      robot_type_ is the SN with its trailing _NNN stripped, so it follows the SN
      rename; the external branch keyed on the old "DA_SF" has to move with it.

      Never write a colon followed by a space anywhere in this file, comments
      included. gazebo_ros2_control hands the whole URDF to rcl as a parameter
      override whose value is parsed as YAML, and that sequence turns the value
      into a mapping, which fails the parse and silently drops the hardware
      plugin (no /motor/state, controllers then see 0 joints).
    -->
    <ros2_control name="dasf_ros2_control" type="system">
      <hardware>
        <plugin>tron2_gazebo/Tron2HWSim</plugin>
      </hardware>

      <!-- Legs (0-9) -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_L_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_roll_L_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_yaw_L_Joint" />
      <xacro:tron2_ctrl_joint name="knee_L_Joint" />
      <xacro:tron2_ctrl_joint name="ankle_pitch_L_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_pitch_R_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_roll_R_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_yaw_R_Joint" />
      <xacro:tron2_ctrl_joint name="knee_R_Joint" />
      <xacro:tron2_ctrl_joint name="ankle_pitch_R_Joint" />

      <!-- Left arm (10-16) -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_roll_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_yaw_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="elbow_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_yaw_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_pitch_L_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_roll_L_U_Joint" />

      <!-- Right arm (17-23) -->
      <xacro:tron2_ctrl_joint name="proximal_pitch_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_roll_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="proximal_yaw_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="elbow_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_yaw_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_pitch_R_U_Joint" />
      <xacro:tron2_ctrl_joint name="wrist_roll_R_U_Joint" />

      <!-- Head (24-25) -->
      <xacro:tron2_ctrl_joint name="head_yaw_Joint" />
      <xacro:tron2_ctrl_joint name="head_pitch_Joint" />

      <!-- IMU state interface (read by Tron2HWSim::registerSensors) -->
      <sensor name="base_imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
      </sensor>
    </ros2_control>

    <!-- IMU Gazebo sensor plugin (ROS2) -->
    <gazebo reference="base_imu">
      <sensor type="imu" name="base_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <ros>
            <namespace></namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Ground truth pose plugin (ROS2 snake_case) -->
    <gazebo>
      <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
        <ros>
          <remapping>odom:=ground_truth/state</remapping>
        </ros>
        <update_rate>1000.0</update_rate>
        <body_name>base_Link</body_name>
        <frame_name>world</frame_name>
        <gaussian_noise>0.0</gaussian_noise>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
      </plugin>
    </gazebo>

    <!-- D435 Camera ROS2 Plugin (mounted on the upper/arm module) -->
    <gazebo reference="d435_U_Link">
      <sensor type="depth" name="d435_camera_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.37375</horizontal_fov>
          <image>
            <format>B8G8R8</format>
            <width>64</width>
            <height>48</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1.2</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>d435</namespace>
          </ros>
          <camera_name>d435_camera</camera_name>
          <frame_name>d435_optical_frame_U</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>1.2</max_depth>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- tron2-xacro helpers begin -->
  <!-- Helper. One ros2_control joint with position/velocity/effort command and state -->
  <xacro:macro name="tron2_ctrl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <!-- Helper. One ROS1 effort controlled joint -->
  <xacro:macro name="tron2_transmission" params="name">
    <transmission name="${name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- 反射转子惯量，MuJoCo <joint armature> 的 URDF 等价物（URDF 与 SDF 都没有 armature）。
       在关节的子连杆上刚性附着一个薄圆盘，izz=armature、ixx=iyy=armature/2，满足刚体惯量
       三角不等式。rpy 把圆盘 z 轴转到关节轴上，取 0、acos(z)、atan2(y,x)。
       与原生 armature 的偏差在于转子也会加载上游关节，末端精确，越靠根部偏高越多。
       依赖 Gazebo 默认的 fixed-joint lumping，转子关节上不要设 disableFixedJointLumping。
       移动关节不加，其 armature 单位为 kg，复现它等于给连杆加真实质量与重力。
       规则与推导见 tron2-xacro skill 的 references/armature.md。 -->
  <xacro:macro name="rotor_inertia" params="joint child armature mass:=1e-4 rpy:='0 0 0'">
    <link name="${joint}_rotor">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${armature / 2.0}" iyy="${armature / 2.0}" izz="${armature}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${joint}_rotor_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <parent link="${child}"/>
      <child link="${joint}_rotor"/>
    </joint>
  </xacro:macro>
  <!-- tron2-xacro helpers end -->

  <xacro:macro name="ros1_gazebo_all">
    <gazebo>
      <plugin filename="libtron2_hw_sim.so" name="gazebo_ros_control">
        <robotNamespace>/</robotNamespace>
        <robotParam>robot_description</robotParam>
        <robotSimType>tron2_gazebo/Tron2HWSim</robotSimType>
      </plugin>
    </gazebo>
    <!-- tron2-xacro auto begin ros1-transmissions -->
    <xacro:unless value="${use_grasper}">
      <xacro:tron2_transmission name="proximal_pitch_L_Joint" />  <!-- idx 0 -->
      <xacro:tron2_transmission name="proximal_roll_L_Joint" />  <!-- idx 1 -->
      <xacro:tron2_transmission name="proximal_yaw_L_Joint" />  <!-- idx 2 -->
      <xacro:tron2_transmission name="elbow_L_Joint" />  <!-- idx 3 -->
      <xacro:tron2_transmission name="wrist_yaw_L_Joint" />  <!-- idx 4 -->
      <xacro:tron2_transmission name="wrist_pitch_L_Joint" />  <!-- idx 5 -->
      <xacro:tron2_transmission name="wrist_roll_L_Joint" />  <!-- idx 6 -->
      <xacro:tron2_transmission name="proximal_pitch_R_Joint" />  <!-- idx 7 -->
      <xacro:tron2_transmission name="proximal_roll_R_Joint" />  <!-- idx 8 -->
      <xacro:tron2_transmission name="proximal_yaw_R_Joint" />  <!-- idx 9 -->
      <xacro:tron2_transmission name="elbow_R_Joint" />  <!-- idx 10 -->
      <xacro:tron2_transmission name="wrist_yaw_R_Joint" />  <!-- idx 11 -->
      <xacro:tron2_transmission name="wrist_pitch_R_Joint" />  <!-- idx 12 -->
      <xacro:tron2_transmission name="wrist_roll_R_Joint" />  <!-- idx 13 -->
      <xacro:tron2_transmission name="head_pitch_Joint" />  <!-- idx 14 -->
      <xacro:tron2_transmission name="head_yaw_Joint" />  <!-- idx 15 -->
    </xacro:unless>
    <xacro:if value="${use_grasper}">
      <xacro:tron2_transmission name="proximal_pitch_L_Joint" />  <!-- idx 0 -->
      <xacro:tron2_transmission name="proximal_roll_L_Joint" />  <!-- idx 1 -->
      <xacro:tron2_transmission name="proximal_yaw_L_Joint" />  <!-- idx 2 -->
      <xacro:tron2_transmission name="elbow_L_Joint" />  <!-- idx 3 -->
      <xacro:tron2_transmission name="wrist_yaw_L_Joint" />  <!-- idx 4 -->
      <xacro:tron2_transmission name="wrist_pitch_L_Joint" />  <!-- idx 5 -->
      <xacro:tron2_transmission name="wrist_roll_L_Joint" />  <!-- idx 6 -->
      <xacro:tron2_transmission name="proximal_pitch_R_Joint" />  <!-- idx 7 -->
      <xacro:tron2_transmission name="proximal_roll_R_Joint" />  <!-- idx 8 -->
      <xacro:tron2_transmission name="proximal_yaw_R_Joint" />  <!-- idx 9 -->
      <xacro:tron2_transmission name="elbow_R_Joint" />  <!-- idx 10 -->
      <xacro:tron2_transmission name="wrist_yaw_R_Joint" />  <!-- idx 11 -->
      <xacro:tron2_transmission name="wrist_pitch_R_Joint" />  <!-- idx 12 -->
      <xacro:tron2_transmission name="wrist_roll_R_Joint" />  <!-- idx 13 -->
      <xacro:tron2_transmission name="grasper_L_drive_Joint" />  <!-- idx 14 -->
      <xacro:tron2_transmission name="grasper_R_drive_Joint" />  <!-- idx 15 -->
      <xacro:tron2_transmission name="head_pitch_Joint" />  <!-- idx 16 -->
      <xacro:tron2_transmission name="head_yaw_Joint" />  <!-- idx 17 -->
    </xacro:if>
    <!-- tron2-xacro auto end ros1-transmissions -->

    <gazebo reference="depth_camera_link">
      <sensor type="camera" name="depth_camera_color_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>B8G8R8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_color_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>depth_camera</robotNamespace>
          <cameraName>color</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>depth_camera_link</frameName>
        </plugin>
      </sensor>
      <sensor type="depth" name="depth_camera_depth_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_depth_controller" filename="libgazebo_ros_depth_camera.so">
          <robotNamespace>depth_camera</robotNamespace>
          <cameraName>depth</cameraName>
          <imageTopicName>infra/image_raw</imageTopicName>
          <cameraInfoTopicName>infra/camera_info</cameraInfoTopicName>
          <depthImageTopicName>image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>points</pointCloudTopicName>
          <frameName>depth_camera_link</frameName>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="ros2_gazebo_all">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find tron2_gazebo)/config/default_tron2.yaml</parameters>
      </plugin>
    </gazebo>
    <ros2_control name="bipedal_robot_ros2_control" type="system">
      <hardware>
        <plugin>tron2_gazebo/Tron2HWSim</plugin>
      </hardware>

      <!-- tron2-xacro auto begin ros2-joints -->
      <xacro:unless value="${use_grasper}">
        <xacro:tron2_ctrl_joint name="proximal_pitch_L_Joint" />  <!-- idx 0 -->
        <xacro:tron2_ctrl_joint name="proximal_roll_L_Joint" />  <!-- idx 1 -->
        <xacro:tron2_ctrl_joint name="proximal_yaw_L_Joint" />  <!-- idx 2 -->
        <xacro:tron2_ctrl_joint name="elbow_L_Joint" />  <!-- idx 3 -->
        <xacro:tron2_ctrl_joint name="wrist_yaw_L_Joint" />  <!-- idx 4 -->
        <xacro:tron2_ctrl_joint name="wrist_pitch_L_Joint" />  <!-- idx 5 -->
        <xacro:tron2_ctrl_joint name="wrist_roll_L_Joint" />  <!-- idx 6 -->
        <xacro:tron2_ctrl_joint name="proximal_pitch_R_Joint" />  <!-- idx 7 -->
        <xacro:tron2_ctrl_joint name="proximal_roll_R_Joint" />  <!-- idx 8 -->
        <xacro:tron2_ctrl_joint name="proximal_yaw_R_Joint" />  <!-- idx 9 -->
        <xacro:tron2_ctrl_joint name="elbow_R_Joint" />  <!-- idx 10 -->
        <xacro:tron2_ctrl_joint name="wrist_yaw_R_Joint" />  <!-- idx 11 -->
        <xacro:tron2_ctrl_joint name="wrist_pitch_R_Joint" />  <!-- idx 12 -->
        <xacro:tron2_ctrl_joint name="wrist_roll_R_Joint" />  <!-- idx 13 -->
        <xacro:tron2_ctrl_joint name="head_pitch_Joint" />  <!-- idx 14 -->
        <xacro:tron2_ctrl_joint name="head_yaw_Joint" />  <!-- idx 15 -->
      </xacro:unless>
      <xacro:if value="${use_grasper}">
        <xacro:tron2_ctrl_joint name="proximal_pitch_L_Joint" />  <!-- idx 0 -->
        <xacro:tron2_ctrl_joint name="proximal_roll_L_Joint" />  <!-- idx 1 -->
        <xacro:tron2_ctrl_joint name="proximal_yaw_L_Joint" />  <!-- idx 2 -->
        <xacro:tron2_ctrl_joint name="elbow_L_Joint" />  <!-- idx 3 -->
        <xacro:tron2_ctrl_joint name="wrist_yaw_L_Joint" />  <!-- idx 4 -->
        <xacro:tron2_ctrl_joint name="wrist_pitch_L_Joint" />  <!-- idx 5 -->
        <xacro:tron2_ctrl_joint name="wrist_roll_L_Joint" />  <!-- idx 6 -->
        <xacro:tron2_ctrl_joint name="proximal_pitch_R_Joint" />  <!-- idx 7 -->
        <xacro:tron2_ctrl_joint name="proximal_roll_R_Joint" />  <!-- idx 8 -->
        <xacro:tron2_ctrl_joint name="proximal_yaw_R_Joint" />  <!-- idx 9 -->
        <xacro:tron2_ctrl_joint name="elbow_R_Joint" />  <!-- idx 10 -->
        <xacro:tron2_ctrl_joint name="wrist_yaw_R_Joint" />  <!-- idx 11 -->
        <xacro:tron2_ctrl_joint name="wrist_pitch_R_Joint" />  <!-- idx 12 -->
        <xacro:tron2_ctrl_joint name="wrist_roll_R_Joint" />  <!-- idx 13 -->
        <xacro:tron2_ctrl_joint name="grasper_L_drive_Joint" />  <!-- idx 14 -->
        <xacro:tron2_ctrl_joint name="grasper_R_drive_Joint" />  <!-- idx 15 -->
        <xacro:tron2_ctrl_joint name="head_pitch_Joint" />  <!-- idx 16 -->
        <xacro:tron2_ctrl_joint name="head_yaw_Joint" />  <!-- idx 17 -->
      </xacro:if>
      <!-- tron2-xacro auto end ros2-joints -->

    </ros2_control>
    <gazebo reference="depth_camera_link">
      <sensor type="depth" name="depth_camera">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>depth_camera_link</frame_name>
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.001</min_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- tron2-xacro auto begin rotor -->
  <xacro:macro name="rotor_inertia_all">
    <xacro:rotor_inertia joint="proximal_pitch_L_Joint" child="proximal_pitch_L_Link" armature="0.0754" rpy="0 1.65806245894 1.57079632679"/>
    <xacro:rotor_inertia joint="proximal_roll_L_Joint" child="proximal_roll_L_Link" armature="0.0754" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="proximal_yaw_L_Joint" child="proximal_yaw_L_Link" armature="0.0178"/>
    <xacro:rotor_inertia joint="elbow_L_Joint" child="elbow_L_Link" armature="0.0178" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="wrist_yaw_L_Joint" child="wrist_yaw_L_Link" armature="0.0164"/>
    <xacro:rotor_inertia joint="wrist_pitch_L_Joint" child="wrist_pitch_L_Link" armature="0.0164" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="wrist_roll_L_Joint" child="wrist_roll_L_Link" armature="0.0164" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="proximal_pitch_R_Joint" child="proximal_pitch_R_Link" armature="0.0754" rpy="0 1.48353019465 1.57079632679"/>
    <xacro:rotor_inertia joint="proximal_roll_R_Joint" child="proximal_roll_R_Link" armature="0.0754" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="proximal_yaw_R_Joint" child="proximal_yaw_R_Link" armature="0.0178"/>
    <xacro:rotor_inertia joint="elbow_R_Joint" child="elbow_R_Link" armature="0.0178" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="wrist_yaw_R_Joint" child="wrist_yaw_R_Link" armature="0.0164"/>
    <xacro:rotor_inertia joint="wrist_pitch_R_Joint" child="wrist_pitch_R_Link" armature="0.0164" rpy="0 1.57079632679 1.57079632679"/>
    <xacro:rotor_inertia joint="wrist_roll_R_Joint" child="wrist_roll_R_Link" armature="0.0164" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="head_yaw_Joint" child="head_yaw_Link" armature="0.0164"/>
    <xacro:rotor_inertia joint="head_pitch_Joint" child="head_pitch_Link" armature="0.0164" rpy="0 1.57079632679 1.57079632679"/>
  </xacro:macro>
  <!-- tron2-xacro auto end rotor -->

  <!-- tron2-xacro auto begin rotor-grasper -->
  <xacro:macro name="rotor_inertia_grasper">
    <xacro:rotor_inertia joint="grasper_L_drive_Joint" child="grasper_L_crank_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_L_tip_left_Joint" child="grasper_L_jaw_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_L_bar_left_Joint" child="grasper_L_bar_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_L_crank_right_Joint" child="grasper_L_crank_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
    <xacro:rotor_inertia joint="grasper_L_tip_right_Joint" child="grasper_L_jaw_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
    <xacro:rotor_inertia joint="grasper_L_bar_right_Joint" child="grasper_L_bar_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
    <xacro:rotor_inertia joint="grasper_R_drive_Joint" child="grasper_R_crank_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_R_tip_left_Joint" child="grasper_R_jaw_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_R_bar_left_Joint" child="grasper_R_bar_left_Link" armature="0.0005" rpy="0 1.57079632679 0"/>
    <xacro:rotor_inertia joint="grasper_R_crank_right_Joint" child="grasper_R_crank_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
    <xacro:rotor_inertia joint="grasper_R_tip_right_Joint" child="grasper_R_jaw_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
    <xacro:rotor_inertia joint="grasper_R_bar_right_Joint" child="grasper_R_bar_right_Link" armature="0.0005" rpy="0 1.57079632679 3.14159265359"/>
  </xacro:macro>
  <!-- tron2-xacro auto end rotor-grasper -->

  <!-- tron2-xacro auto begin grasper-parallel -->
  <xacro:macro name="grasper_parallel">
    <!-- 闭环，对应 xml connect grasper_L_bar_left_Link ~ grasper_L_jaw_left_Link。ball 与 MuJoCo connect 同为三维位置约束，
         pose 是锚点在 child（即 body1）坐标系下的位置 -->
    <gazebo>
      <joint name="grasper_L_bar_left_Link_loop" type="ball">
        <parent>grasper_L_jaw_left_Link</parent>
        <child>grasper_L_bar_left_Link</child>
        <pose>0 -0.01401 -0.048 0 0 0</pose>
      </joint>
    </gazebo>
    <!-- 闭环，对应 xml connect grasper_L_bar_right_Link ~ grasper_L_jaw_right_Link。ball 与 MuJoCo connect 同为三维位置约束，
         pose 是锚点在 child（即 body1）坐标系下的位置 -->
    <gazebo>
      <joint name="grasper_L_bar_right_Link_loop" type="ball">
        <parent>grasper_L_jaw_right_Link</parent>
        <child>grasper_L_bar_right_Link</child>
        <pose>0 0.01401 -0.048 0 0 0</pose>
      </joint>
    </gazebo>
    <!-- 联动，对应 xml grasper_L_crank_right_Joint = 1 * grasper_L_drive_Joint，gearbox 参考刚体取 lumping 后的 wrist_roll_L_Link -->
    <gazebo>
      <joint name="grasper_L_crank_right_Joint_gearbox" type="gearbox">
        <parent>grasper_L_crank_left_Link</parent>
        <child>grasper_L_crank_right_Link</child>
        <gearbox_reference_body>wrist_roll_L_Link</gearbox_reference_body>
        <gearbox_ratio>-1</gearbox_ratio>
        <axis><xyz>1 0 0</xyz></axis>
        <axis2><xyz>-1 0 0</xyz></axis2>
      </joint>
    </gazebo>
    <!-- grasper_L_nut_Joint ~ grasper_L_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
    <!-- grasper_L_jaw_left_Joint ~ grasper_L_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
    <!-- grasper_L_jaw_right_Joint ~ grasper_L_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
    <!-- 闭环，对应 xml connect grasper_R_bar_left_Link ~ grasper_R_jaw_left_Link。ball 与 MuJoCo connect 同为三维位置约束，
         pose 是锚点在 child（即 body1）坐标系下的位置 -->
    <gazebo>
      <joint name="grasper_R_bar_left_Link_loop" type="ball">
        <parent>grasper_R_jaw_left_Link</parent>
        <child>grasper_R_bar_left_Link</child>
        <pose>0 -0.01401 -0.048 0 0 0</pose>
      </joint>
    </gazebo>
    <!-- 闭环，对应 xml connect grasper_R_bar_right_Link ~ grasper_R_jaw_right_Link。ball 与 MuJoCo connect 同为三维位置约束，
         pose 是锚点在 child（即 body1）坐标系下的位置 -->
    <gazebo>
      <joint name="grasper_R_bar_right_Link_loop" type="ball">
        <parent>grasper_R_jaw_right_Link</parent>
        <child>grasper_R_bar_right_Link</child>
        <pose>0 0.01401 -0.048 0 0 0</pose>
      </joint>
    </gazebo>
    <!-- 联动，对应 xml grasper_R_crank_right_Joint = 1 * grasper_R_drive_Joint，gearbox 参考刚体取 lumping 后的 wrist_roll_R_Link -->
    <gazebo>
      <joint name="grasper_R_crank_right_Joint_gearbox" type="gearbox">
        <parent>grasper_R_crank_left_Link</parent>
        <child>grasper_R_crank_right_Link</child>
        <gearbox_reference_body>wrist_roll_R_Link</gearbox_reference_body>
        <gearbox_ratio>-1</gearbox_ratio>
        <axis><xyz>1 0 0</xyz></axis>
        <axis2><xyz>-1 0 0</xyz></axis2>
      </joint>
    </gazebo>
    <!-- grasper_R_nut_Joint ~ grasper_R_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
    <!-- grasper_R_jaw_left_Joint ~ grasper_R_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
    <!-- grasper_R_jaw_right_Joint ~ grasper_R_drive_Joint 为移动或非线性耦合，Gazebo 侧豁免，仅保留 URDF mimic -->
  </xacro:macro>
  <!-- tron2-xacro auto end grasper-parallel -->

</robot>

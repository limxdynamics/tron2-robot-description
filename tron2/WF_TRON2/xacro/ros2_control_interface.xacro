<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="leg_ros2_control_interface" params="leg_name">

        <joint name="abad_${leg_name}_Joint">
            <command_interface name="position">
                <param name="min">-3.5894441396515377</param>
                <param name="max">2.1526890994098062</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-140</param>
                <param name="max">140</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="hip_${leg_name}_Joint">
            <command_interface name="position">
                <xacro:if value="${leg_name == 'L'}">
                    <param name="min">-0.2605776573227534</param>
                    <param name="max">2.1131489961203007</param>
                </xacro:if>
                <xacro:if value="${leg_name == 'R'}">
                    <param name="min">-2.1131489961203007</param>
                    <param name="max">0.2605776573227534</param>
                </xacro:if>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-140</param>
                <param name="max">140</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="yaw_${leg_name}_Joint">
            <command_interface name="position">
                <xacro:if value="${leg_name == 'L'}">
                    <param name="min">-2.705260340591211</param>
                    <param name="max">1.4835298641951802</param>
                </xacro:if>
                <xacro:if value="${leg_name == 'R'}">
                    <param name="min">-1.4835298641951802</param>
                    <param name="max">2.705260340591211</param>
                </xacro:if>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="knee_${leg_name}_Joint">
            <command_interface name="position">
                <param name="min">-1.7221163729428048</param>
                <param name="max">3.5138713830401835</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-140</param>
                <param name="max">140</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="wheel_${leg_name}_Joint">
            <command_interface name="position">
                <param name="min">-1745329.2519943293</param>
                <param name="max">1745329.2519943293</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-50</param>
                <param name="max">50</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-22</param>
                <param name="max">22</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

    </xacro:macro>

</robot> 
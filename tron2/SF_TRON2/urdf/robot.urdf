  <!-- Joints -->
  <joint name="abad_L_Joint" type="revolute">
    <origin xyz="-0.00045 0.09949 0.06046" rpy="0 0 0"/>
    <parent link="base_Link"/>
    <child link="abad_L_Link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141592653589793" upper="2.600540585471551" effort="130" velocity="12.57"/>
  </joint>

  <joint name="hip_L_Joint" type="revolute">
    <origin xyz="-0.0416 0.0681 0.0" rpy="0 0 0"/>
    <parent link="abad_L_Link"/>
    <child link="hip_L_Link"/>

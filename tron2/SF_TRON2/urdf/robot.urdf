    <child link="abad_L_Link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141592653589793" upper="2.600540585471551" effort="130" velocity="12.57"/>
  </joint>

  <joint name="hip_L_Joint" type="revolute">

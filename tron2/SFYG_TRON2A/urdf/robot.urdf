  <link name="gripper1_Link">
    <inertial>
      <origin xyz="0.00065 -0.04919 0.00972" rpy="0.0 0.0 0.0"/>
      <mass value="0.03"/>
      <inertia ixx="7.371e-05" ixy="-1.13e-06" ixz="2.1e-07" iyy="7.81e-06" iyz="-1.372e-05" izz="7.47e-05"/>

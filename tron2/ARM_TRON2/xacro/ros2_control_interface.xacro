<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="arm_ros2_control_interface" params="arm_name">

        <joint name="abad_${arm_name}_Joint">
            <command_interface name="position">
                <param name="min">-3.141592653589793</param>
                <param name="max">2.600540585471551</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-130</param>
                <param name="max">130</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="hip_${arm_name}_Joint">
            <command_interface name="position">
                <xacro:if value="${arm_name == 'L'}">
                    <param name="min">-0.2605776573227534</param>
                    <param name="max">2.1131489961203007</param>
                </xacro:if>
                <xacro:if value="${arm_name == 'R'}">
                    <param name="min">-2.1131489961203007</param>
                    <param name="max">0.2605776573227534</param>
                </xacro:if>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-130</param>
                <param name="max">130</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="yaw_${arm_name}_Joint">
            <command_interface name="position">
                <xacro:if value="${arm_name == 'L'}">
                    <param name="min">-2.705260340591211</param>
                    <param name="max">1.4835298641951802</param>
                </xacro:if>
                <xacro:if value="${arm_name == 'R'}">
                    <param name="min">-1.4835298641951802</param>
                    <param name="max">2.705260340591211</param>
                </xacro:if>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="knee_${arm_name}_Joint">
            <command_interface name="position">
                <param name="min">-2.6179938779914944</param>
                <param name="max">2.6179938779914944</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-130</param>
                <param name="max">130</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="wrist_yaw1_${arm_name}_Joint">
            <command_interface name="position">
                <param name="min">-2.844886680750757</param>
                <param name="max">2.844886680750757</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="wrist_roll_${arm_name}_Joint">
            <command_interface name="position">
                <param name="min">-1.710422666954443</param>
                <param name="max">1.710422666954443</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="wrist_yaw2_${arm_name}_Joint">
            <command_interface name="position">
                <param name="min">-2.8797932657906435</param>
                <param name="max">2.8797932657906435</param>
            </command_interface> 
            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>
            <command_interface name="Kp">
                <param name="min">0</param>
            </command_interface>
            <command_interface name="Kd">
                <param name="min">0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

    </xacro:macro>

</robot> 